-- Sharing metadata, read by the mod manager's detail pane and by tooling;
-- never by the loader.
return {
  summary = "Online co-op for Gold/Silver/Crystal and Red/Blue/Yellow: one world, two players, 2-vs-2 co-op battles.",
  author = "MochiXLi (Mochx07)",
  contact = "https://github.com/Mochx07/PkMultiplayer",
  tags = { "multiplayer", "co-op", "online", "double-battle", "gen1", "gen2" },
  differences = {
    changed = {
      "trainer, gym, rival, League and boss battles can be fought as a co-op double (HeartGold/SoulSilver doubles rules)",
      "the START menu gains a CO-OP row; the title screen a CO-OP row (continue or new)",
      "Gen 1 and Gen 2 story events, gyms, Hall of Fame and the Bug-Catching Contest are shared with the partner",
    },
    added = {
      "LAN, official Link Hub (no VPN needed) and VPN link (ZeroTier, Tailscale, Radmin, Hamachi, WireGuard; port 7777) with your partner's avatar on the map and Town Map",
      "chat (T), emotes (Y), voice chat (push V / R or open mic, by distance) and touch controls on mobile",
      "2-vs-1 wild co-op (1-vs-1 wild sprite) with timed joint catching (up to x3 catch bonus) and keeper roulette",
      "Cable Club trades and battles directly over the co-op link, P1 vs P2 VS modes and minigames",
      "items on your partner's Pokemon, warp to partner, shared HMs",
    },
    known = {
      "Gen 1 and Gen 2 games only; on other generations the mod does nothing",
      "emote bubbles are drawn pills: the cartridge's own bubble sheet is not imported by Gen2Recomped",
      "both players need the same PkMultiplayer version (nightly.3+ uses link protocol 17)",
    },
  },
  credits = {
    { who = "UNDERdecodedHD / Cedric", for_ = "Gen2Recomped, the game this mod runs in" },
    { who = "bryanthaboi", for_ = "Gen1Recomp, Gen2Recomped's base" },
  },
  compat = { engine = ">=0.7.6 <2.0.0", modApi = 2 },
}
